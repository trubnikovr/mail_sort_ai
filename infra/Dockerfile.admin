FROM node:22-alpine AS web-build
WORKDIR /web
COPY apps/mail-admin/web/package.json ./package.json
COPY apps/mail-admin/web/package-lock.json ./package-lock.json
RUN npm ci
COPY apps/mail-admin/web ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MAIL_ADMIN_WEB_DIST=/app/web/dist
WORKDIR /app

COPY packages/database ./packages/database
COPY packages/logging ./packages/logging
COPY apps/mail-admin/api ./apps/mail-admin/api
COPY --from=web-build /web/dist /app/web/dist

RUN pip install --no-cache-dir ./packages/database ./packages/logging ./apps/mail-admin/api

EXPOSE 8082
CMD ["mail-admin-api"]
