FROM node:22-alpine AS web-build
WORKDIR /web
COPY apps/dashboard/web/package.json ./package.json
COPY apps/dashboard/web/package-lock.json ./package-lock.json
RUN npm ci
COPY apps/dashboard/web ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DASHBOARD_WEB_DIST=/app/web/dist
WORKDIR /app

COPY packages/database ./packages/database
COPY packages/logging ./packages/logging
COPY apps/dashboard/api ./apps/dashboard/api
COPY --from=web-build /web/dist /app/web/dist

RUN pip install --no-cache-dir ./packages/database ./packages/logging ./apps/dashboard/api

EXPOSE 8082
CMD ["sh", "-c", "python -m alembic -c packages/database/alembic.ini upgrade head && exec dashboard-api"]
