{
  "id": null,
  "uid": "mail-sort-email-logs",
  "title": "Mail Sort: поиск по письму",
  "tags": ["mail-sort", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "email_search",
        "label": "ID письма или тема",
        "type": "textbox",
        "current": { "selected": true, "text": "", "value": "" },
        "options": [],
        "query": "",
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "События по письму",
      "datasource": { "type": "loki", "uid": "mail-sort-loki" },
      "targets": [
        {
          "expr": "{service=~\"mail-app|mail-alerts|mail-health|mail-admin\"} |= \"${email_search}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 }
    }
  ]
}
