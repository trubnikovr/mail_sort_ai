# Shared infrastructure
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mail_sort
MAILBOX_PROVIDER=imap
MAILBOX_ACCOUNT_ID=personal-gmail
MAILBOX_SOURCE=INBOX

# IMAP provider
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-gmail@gmail.com
IMAP_APP_PASSWORD=replace-with-a-gmail-app-password

# On-prem Exchange EWS (use instead of the IMAP variables)
# MAILBOX_PROVIDER=ews
# EWS_ENDPOINT=https://exchange.example.com/EWS/Exchange.asmx
# EWS_USERNAME=exchange-user@example.com
# EWS_PASSWORD=replace-with-password

# Mail collector
COLLECTOR_POLL_INTERVAL_SECONDS=60

# Mail decision
AI_PROVIDER=openai
AI_MODEL=replace-with-your-gpt-model-id
AI_AGENT_API_KEY=replace-with-provider-api-key
# For Gemini: AI_PROVIDER=gemini and AI_MODEL=<your-gemini-model-id>
AI_CONFIDENCE_THRESHOLD=0.9
SUBJECT_CONFIDENCE_THRESHOLD=0.95
AI_DAILY_REQUEST_LIMIT=200
AI_MAX_BODY_CHARS=1000
DECISION_POLL_INTERVAL_SECONDS=10
DECISION_WORKER_ID=mail-decision-1

# Mail router
ROUTER_POLL_INTERVAL_SECONDS=10
ROUTER_WORKER_ID=mail-router-1
RETRY_DELAY_SECONDS=60
STALE_JOB_TIMEOUT_SECONDS=300
