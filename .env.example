# Shared infrastructure
# Used by Docker Compose. Change these together if you customize the database.
POSTGRES_DB=mail_sort
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Local tools use localhost; Compose overrides this with the internal DB hostname.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mail_sort
SYSTEM_LOG_RETENTION_DAYS=30
MAILBOX_PROVIDER=imap
MAILBOX_ACCOUNT_ID=personal-gmail
MAILBOX_SOURCE=INBOX

# IMAP provider
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-gmail@gmail.com
IMAP_APP_PASSWORD=replace-with-a-gmail-app-password

# On-prem Exchange EWS (use instead of the IMAP variables)
# MAILBOX_PROVIDER=ews
# EWS_ENDPOINT=https://exchange.example.com/EWS/Exchange.asmx
# EWS_USERNAME=exchange-user@example.com
# EWS_PASSWORD=replace-with-password

# Mail collector
COLLECTOR_POLL_INTERVAL_SECONDS=60

# Mail decision
AI_PROVIDER=openai
AI_MODEL=replace-with-your-gpt-model-id
AI_AGENT_API_KEY=replace-with-provider-api-key
# For Gemini: AI_PROVIDER=gemini and AI_MODEL=<your-gemini-model-id>
AI_CONFIDENCE_THRESHOLD=0.9
SUBJECT_CONFIDENCE_THRESHOLD=0.95
AI_DAILY_REQUEST_LIMIT=200
AI_MAX_BODY_CHARS=1000
DECISION_POLL_INTERVAL_SECONDS=10
DECISION_WORKER_ID=mail-decision-1

# Mail router
ROUTER_POLL_INTERVAL_SECONDS=10
ROUTER_WORKER_ID=mail-router-1
RETRY_DELAY_SECONDS=60
STALE_JOB_TIMEOUT_SECONDS=300

# Operational alerts (create a PRTG HTTP Push Data Advanced sensor and use its full push URL)
PRTG_PUSH_URL=
ALERT_POLL_INTERVAL_SECONDS=5

# PRTG should poll this service from the monitoring host
HEALTH_PORT=8080

# Optional AWS account connectivity check (uses the default boto3 credential chain)
# AWS_REGION=eu-central-1

# Grafana log viewer
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
GRAFANA_PORT=3000
MAIL_ADMIN_PORT=8082
MAIL_ADMIN_USERNAME=admin
MAIL_ADMIN_PASSWORD=admin
MAIL_ADMIN_SESSION_SECRET=replace-with-output-of-python-secrets-token-url-safe
MAIL_ADMIN_SESSION_MAX_AGE_SECONDS=31536000
MAIL_ADMIN_COOKIE_SECURE=false
